<ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="E1 / E5 - Login concurrente" enabled="true">
  <stringProp name="TestPlan.comments">Escenario 1 (carga) y 5 (saturacion progresiva): POST /api/auth/login con segundo factor. Propiedades: login.users, login.rampup, login.loops.</stringProp>
  <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
  <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController">
    <stringProp name="LoopController.loops">${__P(login.loops,5)}</stringProp>
    <boolProp name="LoopController.continue_forever">false</boolProp>
  </elementProp>
  <stringProp name="ThreadGroup.num_threads">${__P(login.users,0)}</stringProp>
  <stringProp name="ThreadGroup.ramp_time">${__P(login.rampup,10)}</stringProp>
  <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
  <boolProp name="ThreadGroup.scheduler">false</boolProp>
  <stringProp name="ThreadGroup.duration"></stringProp>
  <stringProp name="ThreadGroup.delay"></stringProp>
</ThreadGroup>
