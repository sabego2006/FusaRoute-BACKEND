<TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="FusaRoute - carga y estres" enabled="true">
  <stringProp name="TestPlan.comments">Un grupo de hilos por tipo de escenario. Todos arrancan con 0 usuarios: cada corrida enciende los suyos con propiedades -J (ver run.sh y README). El escenario 9 (falla controlada) enciende varios grupos a la vez.</stringProp>
  <boolProp name="TestPlan.functional_mode">false</boolProp>
  <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
  <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
  <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments">
    <collectionProp name="Arguments.arguments"/>
  </elementProp>
</TestPlan>
