<ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="E4 - Flujo completo del negocio" enabled="true">
  <stringProp name="TestPlan.comments">Escenario 4: login, consulta (busqueda de ruta), registro (comentario), actualizacion (editar el comentario) y consulta final (mis comentarios). Propiedades: f.users, f.rampup, f.loops.</stringProp>
