<BeanShellPreProcessor guiclass="TestBeanGUI" testclass="BeanShellPreProcessor" testname="Calcular codigo TOTP" enabled="true">
  <stringProp name="filename"></stringProp>
  <stringProp name="parameters"></stringProp>
  <boolProp name="resetInterpreter">false</boolProp>
  <stringProp name="script">// Codigo TOTP (RFC 6238: SHA1, 6 digitos, 30 s) a partir del secreto del CSV.
// El backend exige el segundo factor en cada login; sin esto todo login daria 401.
// Va en BeanShell y no en un JSR223 con Groovy: el Groovy 3 que trae JMeter 5.6.3
// no puede leer las clases de Java 25 (&quot;Unsupported class file major version 69&quot;).
import javax.crypto.Mac;
import javax.crypto.spec.SecretKeySpec;

String secret = vars.get(&quot;totpSecret&quot;).toUpperCase().replace(&quot;=&quot;, &quot;&quot;).replace(&quot; &quot;, &quot;&quot;);
String alphabet = &quot;ABCDEFGHIJKLMNOPQRSTUVWXYZ234567&quot;;
StringBuffer bits = new StringBuffer();
for (int i = 0; i &lt; secret.length(); i++) {
    String b = Integer.toBinaryString(alphabet.indexOf(secret.charAt(i)));
    while (b.length() &lt; 5) { b = &quot;0&quot; + b; }
    bits.append(b);
}
int n = bits.length() / 8;
byte[] key = new byte[n];
for (int i = 0; i &lt; n; i++) {
    key[i] = (byte) Integer.parseInt(bits.substring(i * 8, i * 8 + 8), 2);
}
long counter = System.currentTimeMillis() / 30000L;
byte[] msg = java.nio.ByteBuffer.allocate(8).putLong(counter).array();
Mac mac = Mac.getInstance(&quot;HmacSHA1&quot;);
mac.init(new SecretKeySpec(key, &quot;HmacSHA1&quot;));
byte[] h = mac.doFinal(msg);
int o = h[h.length - 1] &amp; 0xf;
int bin = ((h[o] &amp; 0x7f) &lt;&lt; 24) | ((h[o + 1] &amp; 0xff) &lt;&lt; 16) | ((h[o + 2] &amp; 0xff) &lt;&lt; 8) | (h[o + 3] &amp; 0xff);
String code = String.valueOf(bin % 1000000);
while (code.length() &lt; 6) { code = &quot;0&quot; + code; }
vars.put(&quot;totpCode&quot;, code);</stringProp>
</BeanShellPreProcessor><hashTree/>
