# Variables de entorno del backend de FusaRoute.
#
# Este archivo ES la documentacion: si una variable no esta aqui, no existe.
# Copiar a .env y llenarlo con los valores propios. El .env NUNCA se versiona.
#
#   cp .env.example .env
#
# Windows PowerShell, para cargarlo antes de arrancar:
#   Get-Content .env | ForEach-Object { if ($_ -match '^\s*([^#][^=]*)=(.*)$') { [Environment]::SetEnvironmentVariable($matches[1].Trim(), $matches[2].Trim()) } }

# --- Perfil activo: dev | pre | prod ---
SPRING_PROFILE=dev
PORT=8080

# --- Base de datos ---
# DEV: PostgreSQL local. Ejemplo de valor:
#   jdbc:postgresql://localhost:5432/fusaroute_dev
# PRE/PROD: cadena del proyecto Supabase correspondiente (se llena en el Sprint 2).
#
# NUNCA el superusuario 'postgres' (ni el admin de Supabase) en DB_USERNAME.
# Cada ambiente usa un usuario dedicado, dueño solo de su base. Ver la seccion
# "Reglas tecnicas" del CLAUDE.md de este repo.
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# --- CORS ---
# Origenes del navegador que pueden llamar a esta API, separados por coma.
# En DEV ya trae por defecto http://localhost:4200,http://localhost:8081
CORS_ALLOWED_ORIGINS=

# --- Google Maps ---
# Clave del BACKEND. Es distinta de la del frontend y no se expone al cliente jamas.
# Restringida por IP/servicio en la consola de Google Cloud.
GOOGLE_MAPS_API_KEY=

# --- Seguridad ---
# Secreto para firmar los JWT (validez de una semana, RNF-04).
JWT_SECRET=
