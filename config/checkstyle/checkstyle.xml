<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
    Ruleset propio de FusaRoute-BACKEND (SCRUM-147), no google_checks.xml del jar.

    Reglas cortas y a proposito: cada una convierte en build rojo algo que el
    CLAUDE.md de este repo ya exige en prosa. Deliberadamente NO incluye reglas
    de formato ruidosas (WhitespaceAround, MagicNumber, JavadocMethod...): un
    analizador que grita en cada linea termina desactivado, y el compromiso
    ante el comite es que el build rojo signifique algo.
-->
<module name="Checker">
    <property name="severity" value="error"/>
    <property name="charset" value="UTF-8"/>

    <module name="TreeWalker">
        <!-- "Errores explicitos": nada de catch vacios que disimulen un fallo. -->
        <module name="EmptyCatchBlock">
            <property name="exceptionVariableName" value="expected|ignored"/>
        </module>

        <!-- Higiene basica de imports. -->
        <module name="UnusedImports"/>
        <module name="RedundantImport"/>
        <module name="IllegalImport">
            <property name="illegalPkgs" value="sun,com.sun"/>
        </module>

        <!-- equals()/hashCode() como contrato: el uno sin el otro es un bug latente. -->
        <module name="EqualsHashCode"/>

        <!-- if/for/while sin llaves esconden bugs de indentacion. -->
        <module name="NeedBraces"/>

        <!-- Un archivo, una clase publica: facilita ubicar el codigo. -->
        <module name="OneTopLevelClass"/>
    </module>

    <!-- Limite de linea generoso: detecta codigo realmente ilegible, no fuerza
         un wrapping agresivo en nombres largos como FindFastestRouteUseCase. -->
    <module name="LineLength">
        <property name="max" value="140"/>
    </module>
</module>
