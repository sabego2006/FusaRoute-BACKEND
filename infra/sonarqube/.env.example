# Documentacion ejecutable: si una variable no esta aqui, no existe.
# Copiar a .env EN LA VM (nunca commitear el .env real) y llenar los valores.
# Las credenciales de BD son solo de la BD interna de SonarQube; no se comparten
# con FusaRoute-BACKEND, son otro Postgres aparte dentro del mismo compose.

# Usuario y contrasena del Postgres de SonarQube.
# Generar la contrasena con:  openssl rand -base64 32
SONAR_DB_USER=sonar
SONAR_DB_PASSWORD=
